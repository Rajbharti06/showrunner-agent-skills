 "tells": [
  {
   "id": "not-just",
   "rx": "\\bnot\\s+(just|only|merely)\\b[^.!?\\n]{3,80}[,;:]\\s*(but\\s+)?(it'?s|it is|also|rather)\\b",
   "msg": "'It is not just X, it is Y'. Pick the Y and say that."
  },
  {
   "id": "isnt-its",
   "rx": "\\b(isn'?t|is not|aren'?t|are not|wasn'?t)\\b[^.!?\\n]{3,60}[,;]\\s*(it'?s|it is|they'?re|they are)\\b",
   "msg": "'It isn't X, it's Y' construction. State the Y directly."
  },
  {
   "id": "rhetorical-opener",
   "rx": "(^|[.!?]\\s+)(ever wondered|have you ever|did you know|imagine (this|a world)|picture this)\\b",
   "msg": "Stock rhetorical opener. Start with the fact itself."
  },
  {
   "id": "whether-youre",
   "rx": "\\bwhether you('?re| are)\\b",
   "msg": "'Whether you are X or Y' is a stock opener. Name the one person it is for."
  },
  {
   "id": "in-a-world",
   "rx": "\\bin a world (where|of)\\b",
   "msg": "'In a world where'. Cut it."
  },
  {
   "id": "heres-what",
   "rx": "\\bhere'?s (what|everything|how|why|the)\\b[^.!?\\n]{0,60}:",
   "msg": "Throat-clearing before a list. Just start the list."
  },
  {
   "id": "and-thats-ok",
   "rx": "\\band that'?s (okay|ok|fine|the point|the beauty)\\b",
   "msg": "'And that is okay.' closer. Cut it."
  },
  {
   "id": "recap-closer",
   "rx": "(^|\\n)\\s*(so,|in short,|bottom line:|the takeaway:|the bottom line)",
   "msg": "Recap closer. If the post worked, the recap is redundant."
  },
  {
   "id": "shouting-run",
   "rx": "\\b(?-i:[A-Z]{3,})\\s+(?-i:[A-Z]{3,})\\s+(?-i:[A-Z]{3,})\\b",
   "msg": "Three shouted words in a row."
  }
 ],
